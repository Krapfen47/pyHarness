# Copy to .env and fill in. Never commit .env.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- semester project harness (all optional; defaults shown) ---
# OLLAMA_MODEL=qwen2.5-coder:7b
# OLLAMA_URL=http://127.0.0.1:11434/api/chat
# Seconds to wait for one model reply (raise it for models bigger than your GPU):
# OLLAMA_TIMEOUT=300
# Full path to docker.exe if it isn't on PATH (found automatically for Docker Desktop):
# HARNESS_DOCKER=C:\Users\<you>\AppData\Local\Programs\DockerDesktop\resources\bin\docker.exe
# Where run workspaces are cloned (default: %TEMP%\harness-runs):
# HARNESS_WORKDIR=
